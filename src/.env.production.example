##############################################################################
# PRODUCTION ENVIRONMENT TEMPLATE - Floz SDN Kelapadua IV
##############################################################################
#
# INSTRUCTIONS:
#   1. Copy this file to .env on the production server:
#        cp .env.production.example .env
#   2. Fill in all values marked with <FILL_IN_...>
#   3. Run: php artisan key:generate (if APP_KEY is blank)
#   4. Run: php artisan config:cache
#
# WARNING: NEVER commit the filled-in .env to version control.
#          The .env file is in .gitignore for this reason.
#          This template file (.env.production.example) contains NO secrets.
#
##############################################################################

# ----- Application -----
APP_NAME="Floz SDN Kelapadua IV"
APP_ENV=production
APP_KEY=<FILL_IN_base64_key_from_artisan_key_generate>
APP_DEBUG=false
APP_URL=https://floz.example.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ----- Logging -----
# LOG_LEVEL=warning keeps noisy debug output out of production logs.
# Change to "error" for minimal logging, "info" for more visibility.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# ----- Database (PostgreSQL) -----
DB_CONNECTION=pgsql
DB_HOST=<FILL_IN_db_host>
DB_PORT=5432
DB_DATABASE=<FILL_IN_db_name>
DB_USERNAME=<FILL_IN_db_user>
DB_PASSWORD=<FILL_IN_db_password>

# ----- Session -----
# SESSION_SECURE_COOKIE=true requires HTTPS. Do NOT set to false in production.
# SESSION_SAME_SITE=strict mitigates CSRF for non-SPA flows.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=<FILL_IN_your_domain_e.g._floz.example.com>
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
SESSION_HTTP_ONLY=true
SESSION_PARTITIONED_COOKIE=false

# ----- Broadcasting / Queue / Cache -----
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ----- Redis (optional — leave defaults if not using Redis) -----
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ----- Mail -----
# Replace mailpit (dev SMTP trap) with a real provider.
MAIL_MAILER=smtp
MAIL_HOST=<FILL_IN_smtp_host>
MAIL_PORT=587
MAIL_USERNAME=<FILL_IN_smtp_user>
MAIL_PASSWORD=<FILL_IN_smtp_password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="admin@sdnkelapadua4.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# ----- AWS (leave blank if not using S3) -----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ----- Reverb (WebSocket) -----
REVERB_APP_ID=<FILL_IN_reverb_app_id>
REVERB_APP_KEY=<FILL_IN_reverb_app_key>
REVERB_APP_SECRET=<FILL_IN_reverb_app_secret>
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=https

# ----- Vite / Frontend -----
VITE_APP_NAME="${APP_NAME}"
